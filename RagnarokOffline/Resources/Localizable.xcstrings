    "The app no longer provides a hosted remote client." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App stellt keinen gehosteten Remote-Client mehr bereit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app ya no ofrece un cliente remoto alojado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app ne fournit plus de client distant hébergé."
          }
        },
