          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱에서 호스팅하는 원격 클라이언트는 더 이상 제공되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app não fornece mais um cliente remoto hospedado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение больше не предоставляет размещённый удалённый клиент."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แอปไม่ได้ให้บริการโฮสต์ไคลเอนต์ระยะไกลอีกต่อไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama artık barındırılan bir uzak istemci sunmuyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本应用不再提供托管的远程客户端。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本 App 不再提供託管的遠端用戶端。"
          }
        }
      }
    },
    "To use **Remote Client**, turn on **Use Remote Client** in **Settings** and enter your own URL." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um den **Remote-Client** zu nutzen, aktiviere **Remote-Client verwenden** in den **Einstellungen** und gib deine eigene URL ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para usar el **cliente remoto**, activa **Usar cliente remoto** en **Configuración** e introduce la URL de tu cliente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour utiliser le **client distant**, activez **Utiliser le client distant** dans les **Paramètres**, puis saisissez l’URL de votre propre client distant."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk menggunakan klien jarak jauh, aktifkan **Gunakan klien jarak jauh** di **Pengaturan** dan masukkan URL klien Anda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**リモートクライアント**を利用するには、**設定**で**リモートクライアントを使用**をオンにして、ご自身のリモートクライアントのURLを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직접 구축한 원격 클라이언트를 사용하려면 **설정**에서 **원격 클라이언트 사용**을 켜고 해당 URL을 입력하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para usar o cliente remoto, ative **Usar cliente remoto** em **Configurações** e informe a URL do seu próprio cliente remoto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы использовать **Удалённый клиент**, включите **Использовать удалённый клиент** в разделе **Настройки** и введите URL собственного удалённого клиента."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากต้องการใช้ **ไคลเอนต์ระยะไกล** ให้เปิด **ใช้ไคลเอนต์ระยะไกล** ใน **การตั้งค่า** แล้วป้อน URL ของไคลเอนต์ระยะไกลที่คุณสร้างเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendi uzak istemcinizi kullanmak için **Ayarlar** bölümünde **Uzak istemciyi kullan** seçeneğini açıp istemcinizin URL’sini girin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如需使用**远程客户端**，请在**设置**中开启**使用远程客户端**，然后输入自己搭建的远程客户端 URL。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要使用**遠端用戶端**，請在**設定**中開啟**使用遠端用戶端**，再輸入自行架設的遠端用戶端 URL。"
          }
        }
      }
    },
