    "Add data.grf and the BGM folder to **Local Client Files** to use the app entirely offline." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge data.grf und den BGM-Ordner zu den **lokalen Client-Dateien** hinzu, um die App vollständig offline zu nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade data.grf y la carpeta BGM a la sección **Archivos del cliente local** para usar la app completamente sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez data.grf et le dossier BGM aux **Fichiers du client local** pour utiliser l’app entièrement hors ligne."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan data.grf dan folder BGM ke **File klien lokal** untuk menggunakan aplikasi sepenuhnya secara offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "data.grf と BGM フォルダを**ローカルクライアントファイル**に追加すると、アプリを完全にオフラインで使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "data.grf와 BGM 폴더를 **로컬 클라이언트 파일**에 추가하면 앱을 완전히 오프라인으로 사용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione data.grf e a pasta BGM à seção **Arquivos do cliente local** para usar o app totalmente offline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте data.grf и папку BGM в **Файлы локального клиента**, чтобы использовать приложение полностью офлайн."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่ม data.grf และโฟลเดอร์ BGM ลงใน **ไฟล์ไคลเอนต์ในเครื่อง** เพื่อใช้แอปแบบออฟไลน์ได้ทั้งหมด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamayı tamamen çevrimdışı kullanmak için data.grf dosyasını ve BGM klasörünü **Yerel istemci dosyaları** bölümüne ekleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 data.grf 和 BGM 文件夹添加到**本地客户端文件**中，即可完全离线使用本应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將 data.grf 和 BGM 資料夾加入**本機用戶端檔案**中，即可完全離線使用本 App。"
          }
