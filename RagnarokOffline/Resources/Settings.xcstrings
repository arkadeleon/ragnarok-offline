    "Your support helps keep RagOff free for everyone. Patrons get early access to new features." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Unterstützung hilft, RagOff für alle kostenlos zu halten. Unterstützer erhalten Vorabzugang zu neuen Funktionen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your support helps keep RagOff free for everyone. Patrons get early access to new features."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu apoyo ayuda a mantener RagOff gratis para todos. Los mecenas tienen acceso anticipado a las nuevas funciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre soutien aide à maintenir RagOff gratuit pour tous. Les mécènes bénéficient d’un accès anticipé aux nouvelles fonctionnalités."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dukungan Anda membantu menjaga RagOff tetap gratis untuk semua orang. Pendukung mendapatkan akses awal ke fitur baru."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "皆さまのご支援により、RagOffを誰もが無料で利用できます。サポーターは新機能をいち早く体験できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러분의 후원은 누구나 RagOff를 무료로 사용할 수 있도록 돕습니다. 후원자는 새로운 기능을 미리 체험할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu apoio ajuda a manter o RagOff gratuito para todos. Apoiadores têm acesso antecipado a novos recursos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша поддержка помогает сохранять RagOff бесплатным для всех. Спонсоры получают ранний доступ к новым функциям."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การสนับสนุนของคุณช่วยให้ทุกคนใช้ RagOff ได้ฟรี ผู้สนับสนุนสามารถทดลองใช้ฟีเจอร์ใหม่ก่อนใคร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desteğiniz, RagOff’un herkes için ücretsiz kalmasına yardımcı olur. Destekçiler yeni özelliklere erken erişim elde eder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的支持帮助 RagOff 保持向所有人免费提供。赞助者可以提前体验新功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的支持幫助 RagOff 保持向所有人免費提供。贊助者可以提前體驗新功能。"
          }
        }
      }
    }
  },
  "version" : "1.2"
